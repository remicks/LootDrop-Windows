<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ControlTheme x:Key="PreferenceSwitch" TargetType="CheckBox">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="42,*" ColumnSpacing="12" Background="Transparent">
                        <Border x:Name="SwitchTrack" Width="42" Height="24" VerticalAlignment="Center" CornerRadius="12" BorderThickness="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}">
                            <Border.Transitions><Transitions><BrushTransition Property="Background" Duration="0:0:0.14"/></Transitions></Border.Transitions>
                            <Border x:Name="SwitchKnob" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" Background="{DynamicResource PrimaryTextBrush}">
                                <Border.Transitions><Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.14" Easing="CubicEaseOut"/></Transitions></Border.Transitions>
                            </Border>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" TextWrapping="Wrap" RecognizesAccessKey="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#SwitchTrack"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
            <Style Selector="^:checked /template/ Border#SwitchKnob"><Setter Property="Margin" Value="20,0,0,0"/><Setter Property="Background" Value="{DynamicResource OnAccentBrush}"/></Style>
            <Style Selector="^:pointerover /template/ Border#SwitchTrack"><Setter Property="BorderBrush" Value="{DynamicResource TextAccentBrush}"/></Style>
            <Style Selector="^:focus-visible /template/ Border#SwitchTrack"><Setter Property="BorderBrush" Value="{DynamicResource TextAccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
            <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="Button"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="CheckBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="10,0,0,0"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="9"/><Setter Property="MinHeight" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="Button.offer-icon"><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="17"/><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="Border.settings-card"><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="Window.docked Border.settings-card"><Setter Property="Padding" Value="16"/></Style>
    <Style Selector="Button.settings-link"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style Selector="Expander.offer-group /template/ ToggleButton"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="CornerRadius" Value="12,12,0,0"/></Style>
    <Style Selector="Window.reduced-motion CheckBox /template/ Border#SwitchTrack"><Setter Property="Transitions" Value="{x:Null}"/></Style>
    <Style Selector="Window.reduced-motion CheckBox /template/ Border#SwitchKnob"><Setter Property="Transitions" Value="{x:Null}"/></Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource OnAccentBrush}"/></Style>
    <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle"><Setter Property="BorderBrush" Value="{DynamicResource TextAccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Slider"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="Slider /template/ Thumb"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="CheckBox:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
</Styles>
